#!/usr/bin/env bash
# mimo — CLI for the mimo memory system for Claude Code
# shellcheck disable=SC2059  # color codes are embedded in the printf format on purpose
set -euo pipefail

# Version is stamped by the installer (sed replaces every __VERSION__). When run
# from a dev clone the placeholder is still present, so fall back to the local
# VERSION file, then to "dev". The sentinel is reconstructed from two pieces so
# the installer's global sed does not rewrite this guard as well.
MIMO_VERSION="__VERSION__"
_mimo_placeholder="__VER""SION__"
if [ "$MIMO_VERSION" = "$_mimo_placeholder" ]; then
    MIMO_VERSION=$(cat "$(dirname "$0")/VERSION" 2>/dev/null || echo "dev")
fi
unset _mimo_placeholder
HOOKS_DIR="$HOME/.claude/hooks"
STATE_DIR="$HOME/.claude/memory-state"
BACKUP_DIR="$HOME/.claude/backups"
SETTINGS_FILE="$HOME/.claude/settings.json"
TEMPLATES_DIR="${MIMO_TEMPLATES_DIR:-$HOME/.claude/mimo-templates}"
USER_PROFILE_FILE="${MIMO_USER_PROFILE_FILE:-$HOME/.claude/mimo-user.md}"

# ─── Config (defaults, then user overrides via ~/.claude/mimo.conf) ──────────
CHECKPOINT_THRESHOLD=50
FULLSAVE_THRESHOLD=80
BAR_WIDTH=20
AUTO_INIT=git-only
WORKFLOW_BLOCK=off
BACKUP_RETENTION_DAYS=30
STALE_MINUTES=120
MIMO_CONF="${MIMO_CONF:-$HOME/.claude/mimo.conf}"
# shellcheck disable=SC1090
[ -f "$MIMO_CONF" ] && . "$MIMO_CONF"
# Sessions with no StatusLine heartbeat in this many seconds are considered stale
STALE_THRESHOLD=$(( STALE_MINUTES * 60 ))

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

ok()    { printf "  ${GREEN}[ok]${NC} %s\n" "$1"; }
fail()  { printf "  ${RED}[!!]${NC} %s\n" "$1"; }
warn()  { printf "  ${YELLOW}[warn]${NC} %s\n" "$1"; }
dim()   { printf "  ${YELLOW}[-]${NC}  %s\n" "$1"; }
info()  { printf "${GREEN}[mimo]${NC} %s\n" "$1"; }
error() { printf "${RED}[mimo]${NC} %s\n" "$1" >&2; }

cmd_version() {
    echo "mimo v${MIMO_VERSION}"
}

cmd_status() {
    echo ""
    printf "${BOLD}mimo status${NC}\n"
    echo ""

    # Hook scripts
    printf "${BOLD}Hook scripts:${NC}\n"
    for hook in statusline-memory.sh memory-gate.sh precompact-save.sh session-start.sh session-start-compact.sh session-end-backup.sh subagent-context.sh user-prompt-context.sh track-changes.sh; do
        if [ -x "$HOOKS_DIR/$hook" ]; then
            ok "$hook"
        else
            fail "$hook (missing or not executable)"
        fi
    done

    echo ""
    printf "${BOLD}Settings:${NC}\n"
    if [ -f "$SETTINGS_FILE" ]; then
        HOOK_COUNT=$(jq '[.hooks[][]?.hooks[]? | select(.command // "" | contains("/.claude/hooks/"))] | length' "$SETTINGS_FILE" 2>/dev/null || echo "0")
        if [ "$HOOK_COUNT" -gt 0 ]; then
            ok "Hooks registered in settings.json ($HOOK_COUNT entries)"
        else
            fail "No mimo hooks found in settings.json"
        fi

        SL=$(jq -r '.statusLine.command // ""' "$SETTINGS_FILE" 2>/dev/null || echo "")
        if echo "$SL" | grep -q 'statusline-memory'; then
            ok "StatusLine configured"
        else
            fail "StatusLine not configured"
        fi
    else
        fail "settings.json not found"
    fi

    echo ""
    printf "${BOLD}Dependencies:${NC}\n"
    if command -v jq &>/dev/null; then
        ok "jq $(jq --version 2>&1 | tr -d 'jq-')"
    else
        fail "jq not installed"
    fi
    ok "bash ${BASH_VERSION}"

    echo ""
    printf "${BOLD}Skills:${NC}\n"
    for skill in save save-full pcompact; do
        if [ -f "$HOME/.claude/skills/$skill/SKILL.md" ]; then
            ok "/$skill"
        else
            fail "/$skill (not installed)"
        fi
    done

    echo ""
    printf "${BOLD}Config:${NC}\n"
    if [ -f "$MIMO_CONF" ]; then
        OVERRIDES=""
        [ "$CHECKPOINT_THRESHOLD" != "50" ]  && OVERRIDES="$OVERRIDES CHECKPOINT_THRESHOLD=$CHECKPOINT_THRESHOLD"
        [ "$FULLSAVE_THRESHOLD" != "80" ]    && OVERRIDES="$OVERRIDES FULLSAVE_THRESHOLD=$FULLSAVE_THRESHOLD"
        [ "$BAR_WIDTH" != "20" ]             && OVERRIDES="$OVERRIDES BAR_WIDTH=$BAR_WIDTH"
        [ "$AUTO_INIT" != "git-only" ]       && OVERRIDES="$OVERRIDES AUTO_INIT=$AUTO_INIT"
        [ "$WORKFLOW_BLOCK" != "off" ]       && OVERRIDES="$OVERRIDES WORKFLOW_BLOCK=$WORKFLOW_BLOCK"
        [ "$BACKUP_RETENTION_DAYS" != "30" ] && OVERRIDES="$OVERRIDES BACKUP_RETENTION_DAYS=$BACKUP_RETENTION_DAYS"
        [ "$STALE_MINUTES" != "120" ]        && OVERRIDES="$OVERRIDES STALE_MINUTES=$STALE_MINUTES"
        if [ -n "$OVERRIDES" ]; then
            ok "$MIMO_CONF (overrides:)"
            for kv in $OVERRIDES; do dim "$kv"; done
        else
            ok "$MIMO_CONF (all defaults)"
        fi
    else
        dim "defaults (no ~/.claude/mimo.conf)"
    fi

    echo ""
    printf "${BOLD}User profile:${NC}\n"
    if [ -f "$USER_PROFILE_FILE" ]; then
        PLINES=$(wc -l < "$USER_PROFILE_FILE" 2>/dev/null | tr -d '[:space:]' || echo 0)
        ok "present (${PLINES} lines)"
    else
        dim "absent (written on the first /save-full with cross-project signal)"
    fi

    echo ""
    printf "${BOLD}Active sessions:${NC}\n"
    SESSION_COUNT=0
    NOW=$(date +%s)
    if [ -d "$STATE_DIR" ]; then
        for sf in "$STATE_DIR"/*.json; do
            [ -f "$sf" ] || continue
            case "$sf" in *.tmp) continue ;; esac
            SESSION_COUNT=$((SESSION_COUNT + 1))
            SID=$(jq -r '.session_id // "?"' "$sf" 2>/dev/null || echo "?")
            PCT=$(jq -r '.percentage // 0' "$sf" 2>/dev/null || echo "0")
            THRESHOLD=$(jq -r '.threshold // "clean"' "$sf" 2>/dev/null || echo "clean")
            LAST_UPDATE=$(stat -f %m "$sf" 2>/dev/null || stat -c %Y "$sf" 2>/dev/null || echo "0")
            AGE=$(( NOW - LAST_UPDATE ))
            if [ "$AGE" -gt "$STALE_THRESHOLD" ]; then
                dim "${SID}: ${PCT}%, stale (last seen $(( AGE / 3600 ))h ago)"
            else
                ok "${SID}: ${PCT}%, threshold: ${THRESHOLD}"
            fi
        done
    fi
    if [ "$SESSION_COUNT" -eq 0 ]; then
        dim "No active sessions"
    fi

    echo ""
    printf "${BOLD}Current project:${NC}\n"
    if [ -f "CLAUDE.md" ]; then
        if grep -q 'Memory — Current State' CLAUDE.md 2>/dev/null; then
            ok "CLAUDE.md has memory sections"
        else
            dim "CLAUDE.md exists but no memory sections (run: mimo init)"
        fi
    else
        dim "No CLAUDE.md in current directory"
    fi
    if [ -f "CLAUDE-FULL.md" ]; then
        LINES=$(wc -l < "CLAUDE-FULL.md" | tr -d ' ')
        ok "CLAUDE-FULL.md (${LINES} lines)"
    else
        dim "No CLAUDE-FULL.md (run: mimo init)"
    fi

    echo ""
}

# Emit the memory sections — from the installed template, with a built-in
# fallback so `mimo init` still works if templates are missing.
_emit_memory_sections() {
    if [ -f "$TEMPLATES_DIR/claude-md-memory-sections.md" ]; then
        cat "$TEMPLATES_DIR/claude-md-memory-sections.md"
    else
        cat << 'MEMORY_SECTIONS'
## Memory — Current State
<!-- Updated by mimo checkpoint/save hooks. On load act only on "Next actionable"; Carried-over is stale reference unless the user re-asks. -->
Last session: (not yet set)
Focus: (not yet set)
Next actionable (verbatim): None
Blockers: None
Carried-over (STALE — do not auto-resume): None

## Memory — Project Card
<!-- Durable only — if it plausibly changes this quarter, it doesn't belong. Max ~30 lines. -->
<!-- Every line: - PREFIX: fact.  Allowed: STACK, CONVENTION, ENTRYPOINT, TOOL-RULE, FAILURE-LESSON, RELATIONSHIP, INSTRUCTION -->

## Memory — Recent Sessions
<!-- Rolling list, max 7 entries. Oldest dropped. -->
<!-- Each entry references a CLAUDE-FULL.md anchor like [CLAUDE-FULL.md §S12] -->

## Memory — Key Decisions
<!-- One-liner + CLAUDE-FULL.md anchor (e.g. [CLAUDE-FULL.md §S12]); max 10, move oldest into its session entry -->
MEMORY_SECTIONS
    fi
}

cmd_init() {
    local with_workflow=false force_home=false
    for arg in "$@"; do
        case "$arg" in
            --with-workflow) with_workflow=true ;;
            --force-home)    force_home=true ;;
            *) error "Unknown option for init: $arg"; exit 1 ;;
        esac
    done
    # WORKFLOW_BLOCK=on in the config also opts every init into the workflow block.
    [ "$WORKFLOW_BLOCK" = "on" ] && with_workflow=true

    # $HOME guard: a CLAUDE.md here loads into every Claude Code session
    # (cross-project contamination). Require an explicit override.
    if [ "$(pwd)" = "$HOME" ] && [ "$force_home" != "true" ]; then
        error "Refusing to initialize memory in your home directory ($HOME)."
        error "A CLAUDE.md here loads into EVERY Claude Code session (cross-project contamination)."
        error "Re-run with 'mimo init --force-home' if you really mean to."
        exit 1
    fi

    echo ""
    printf "${BOLD}mimo init${NC} — setting up memory for this project\n"
    echo ""

    MEMORY_MARKER="Memory — Current State"

    # CLAUDE.md
    if [ ! -f "CLAUDE.md" ]; then
        # Fresh file: title + description, optional workflow block, memory sections.
        {
            echo "# CLAUDE.md"
            echo ""
            echo "This file provides guidance to Claude Code (claude.ai/code) when working with code in this repository."
            echo ""
            if [ "$with_workflow" = "true" ]; then
                if [ -f "$TEMPLATES_DIR/claude-md-workflow.md" ]; then
                    cat "$TEMPLATES_DIR/claude-md-workflow.md"
                    echo ""
                else
                    warn "workflow template missing ($TEMPLATES_DIR) — skipping workflow block"
                fi
            fi
            _emit_memory_sections
        } > CLAUDE.md
        if [ "$with_workflow" = "true" ]; then
            ok "Created CLAUDE.md with workflow guidance and memory sections"
        else
            ok "Created CLAUDE.md with memory sections"
        fi

    elif grep -q "$MEMORY_MARKER" CLAUDE.md 2>/dev/null; then
        ok "CLAUDE.md already has memory sections (skipping)"

    else
        # Existing CLAUDE.md without memory sections. Never prepend: appending
        # keeps the file's opening bytes intact (no duplicate # CLAUDE.md title,
        # no disruption of the user's own top content). With --with-workflow and
        # no existing block, append the workflow block at the END too.
        if [ "$with_workflow" = "true" ] \
           && ! grep -q "## Workflow Orchestration" CLAUDE.md 2>/dev/null; then
            if [ -f "$TEMPLATES_DIR/claude-md-workflow.md" ]; then
                {
                    echo ""
                    cat "$TEMPLATES_DIR/claude-md-workflow.md"
                } >> CLAUDE.md
                ok "Appended workflow guidance to CLAUDE.md"
            else
                warn "workflow template missing ($TEMPLATES_DIR) — skipping workflow block"
            fi
        fi
        {
            echo ""
            _emit_memory_sections
        } >> CLAUDE.md
        ok "Added memory sections to CLAUDE.md"
    fi

    # CLAUDE-FULL.md
    if [ -f "CLAUDE-FULL.md" ]; then
        ok "CLAUDE-FULL.md already exists (skipping)"
    else
        if [ -f "$TEMPLATES_DIR/CLAUDE-FULL.md" ]; then
            cat "$TEMPLATES_DIR/CLAUDE-FULL.md" > CLAUDE-FULL.md
        else
            cat > CLAUDE-FULL.md << 'ARCHIVE'
# Deep Memory Archive

<!-- Detailed session logs for long-term context preservation. -->
<!-- Each session is a heading: ## S<N> — YYYY-MM-DD — <short-slug>  (e.g. ## S12 — 2026-03-08 — anchor refs). -->
<!-- CLAUDE.md references entries by anchor, e.g. [CLAUDE-FULL.md §S12]. Locate one with: grep -n '^## S' CLAUDE-FULL.md -->
ARCHIVE
        fi
        ok "Created CLAUDE-FULL.md"
    fi

    echo ""
    printf "${GREEN}[mimo]${NC} Project initialized. Start a Claude Code session to begin building memory.\n"
    echo ""
}

cmd_update() {
    echo ""
    printf "${BOLD}mimo update${NC}\n"
    echo ""

    REMOTE_VERSION=$(curl -fsSL --max-time 5 \
        "https://raw.githubusercontent.com/ShivanDana/mimo/main/VERSION" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$REMOTE_VERSION" ]; then
        error "Could not fetch remote version. Check your network connection."
        exit 1
    fi

    INSTALLED_VERSION=$(cat "$STATE_DIR/mimo-installed-version" 2>/dev/null || echo "unknown")

    if [ "$REMOTE_VERSION" = "$INSTALLED_VERSION" ]; then
        info "Already up to date (v${INSTALLED_VERSION})"
        exit 0
    fi

    info "Updating mimo v${INSTALLED_VERSION} → v${REMOTE_VERSION}..."
    echo ""

    # Run the installer pinned to the target version. Fall back to main if the
    # version tag does not exist yet (tags may lag the VERSION file).
    PINNED_URL="https://raw.githubusercontent.com/ShivanDana/mimo/v${REMOTE_VERSION}/install.sh"
    MAIN_URL="https://raw.githubusercontent.com/ShivanDana/mimo/main/install.sh"

    INSTALLER=$(curl -fsSL "$PINNED_URL" 2>/dev/null || echo "")
    if [ -z "$INSTALLER" ]; then
        INSTALLER=$(curl -fsSL "$MAIN_URL" 2>/dev/null || echo "")
    fi
    if [ -z "$INSTALLER" ]; then
        error "Could not download the installer. Check your network connection."
        exit 1
    fi
    echo "$INSTALLER" | bash
}

cmd_uninstall() {
    if [ -f "$HOME/.local/bin/mimo-uninstall" ]; then
        exec bash "$HOME/.local/bin/mimo-uninstall"
    else
        printf "${RED}[mimo]${NC} mimo-uninstall not found. Run manually:\n" >&2
        echo "  curl -fsSL https://raw.githubusercontent.com/ShivanDana/mimo/main/uninstall.sh | bash"
        exit 1
    fi
}

cmd_cleanup() {
    echo ""
    printf "${BOLD}mimo cleanup${NC}\n"
    echo ""

    NOW=$(date +%s)
    STALE_COUNT=0
    ORPHAN_COUNT=0
    TMP_COUNT=0
    BACKUP_COUNT=0

    if [ -d "$STATE_DIR" ]; then
        # Remove stale session triples (no StatusLine heartbeat in >2h)
        for f in "$STATE_DIR"/*.json; do
            [ -f "$f" ] || continue
            case "$f" in *.tmp) continue ;; esac
            LAST_UPDATE=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo "0")
            AGE=$(( NOW - LAST_UPDATE ))
            if [ "$AGE" -gt "$STALE_THRESHOLD" ]; then
                SID=$(basename "$f" .json)
                rm -f "$f" "$STATE_DIR/${SID}-changes.log" "$STATE_DIR/${SID}-postcompact.flag"
                STALE_COUNT=$((STALE_COUNT + 1))
            fi
        done

        # Sweep orphaned companion files: -changes.log / -postcompact.flag whose
        # json is already gone (e.g. reaped earlier by session-start cleanup). The
        # loop above only reaches companions of a still-present stale json, so a
        # json-less companion would otherwise linger forever. Deleted pairwise —
        # only when no matching json exists, so live sessions are never touched.
        for f in "$STATE_DIR"/*-changes.log "$STATE_DIR"/*-postcompact.flag; do
            [ -f "$f" ] || continue
            BASE=$(basename "$f")
            case "$BASE" in
                *-changes.log)      SID=${BASE%-changes.log} ;;
                *-postcompact.flag) SID=${BASE%-postcompact.flag} ;;
                *)                  continue ;;
            esac
            if [ ! -f "$STATE_DIR/${SID}.json" ]; then
                rm -f "$f"
                ORPHAN_COUNT=$((ORPHAN_COUNT + 1))
            fi
        done

        # Remove orphaned jq temp files older than 60 min
        TMP_COUNT=$(find "$STATE_DIR" -name "*.tmp" -mmin +60 2>/dev/null | wc -l | tr -d ' ')
        find "$STATE_DIR" -name "*.tmp" -mmin +60 -delete 2>/dev/null || true
    fi

    # Prune transcript backups older than the retention window
    if [ -d "$BACKUP_DIR" ]; then
        BACKUP_COUNT=$(find "$BACKUP_DIR" \( -name "*.jsonl" -o -name "*-precompact-summary.md" \) -mtime +${BACKUP_RETENTION_DAYS} 2>/dev/null | wc -l | tr -d ' ')
        find "$BACKUP_DIR" \( -name "*.jsonl" -o -name "*-precompact-summary.md" \) -mtime +${BACKUP_RETENTION_DAYS} -delete 2>/dev/null || true
    fi

    if [ "$STALE_COUNT" -gt 0 ]; then
        info "Removed $STALE_COUNT stale session(s)"
    else
        info "No stale sessions found (all sessions are active)"
    fi
    if [ "$ORPHAN_COUNT" -gt 0 ]; then
        info "Removed $ORPHAN_COUNT orphaned companion file(s)"
    fi
    info "Removed $TMP_COUNT orphaned temp file(s)"
    info "Removed $BACKUP_COUNT old backup(s) (>${BACKUP_RETENTION_DAYS}d)"
    echo ""
}

cmd_sessions() {
    echo ""
    printf "${BOLD}mimo sessions${NC}\n"
    echo ""
    if [ ! -f "CLAUDE-FULL.md" ]; then
        dim "No CLAUDE-FULL.md in the current directory (run: mimo init)"
        echo ""
        return 0
    fi

    # Session anchors: ## S<N> — YYYY-MM-DD — <slug>. Match S followed by a digit
    # so a stray "## Sessions" header (legacy template) never counts.
    MATCHES=$(grep -nE '^## S[0-9]+ ' CLAUDE-FULL.md 2>/dev/null || true)
    if [ -z "$MATCHES" ]; then
        dim "No § session anchors found in CLAUDE-FULL.md."
        dim "Entries from the legacy line-reference era won't appear here — only new '## S<N>' anchors are listed."
        echo ""
        return 0
    fi

    # grep returns file order: oldest first, newest last.
    printf '%s\n' "$MATCHES" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        lineno=${line%%:*}
        heading=${line#*:}
        num=$(printf '%s' "$heading" | sed -E 's/^(## S[0-9]+).*/\1/; s/^## //')
        detail=$(printf '%s' "$heading" | sed -E 's/^## S[0-9]+[[:space:]]*//')
        printf "  ${BOLD}%s${NC}  %s  ${YELLOW}(line %s)${NC}\n" "$num" "$detail" "$lineno"
    done
    echo ""
}

cmd_doctor() {
    echo ""
    printf "${BOLD}mimo doctor${NC} — deep diagnostics\n"
    echo ""
    local fails=0

    # ── Hook registrations in settings.json ──────────────────────────────────
    printf "${BOLD}Hook registrations (settings.json):${NC}\n"
    if [ ! -f "$SETTINGS_FILE" ]; then
        fail "settings.json not found at $SETTINGS_FILE"
        fails=$((fails + 1))
    else
        check_reg() {
            # $1 = human label, $2 = exact command string expected in settings
            if jq -e --arg c "$2" \
                '[.hooks[]?[]?.hooks[]?.command // ""] | any(. == $c)' \
                "$SETTINGS_FILE" >/dev/null 2>&1; then
                ok "$1"
            else
                fail "$1 — missing registration ($2)"
                fails=$((fails + 1))
            fi
        }
        check_reg "SessionStart (startup|resume)" "bash ~/.claude/hooks/session-start.sh"
        check_reg "SessionStart (compact)"        "bash ~/.claude/hooks/session-start-compact.sh"
        check_reg "Stop"                          "bash ~/.claude/hooks/memory-gate.sh"
        check_reg "PreCompact"                    "bash ~/.claude/hooks/precompact-save.sh"
        check_reg "SessionEnd"                    "bash ~/.claude/hooks/session-end-backup.sh"
        check_reg "SubagentStart"                 "bash ~/.claude/hooks/subagent-context.sh"
        check_reg "UserPromptSubmit"              "bash ~/.claude/hooks/user-prompt-context.sh"
        check_reg "PostToolUse"                   "bash ~/.claude/hooks/track-changes.sh"

        # statusLine — the single point of failure for the whole system.
        SL=$(jq -r '.statusLine.command // ""' "$SETTINGS_FILE" 2>/dev/null || echo "")
        if echo "$SL" | grep -q 'statusline-memory.sh'; then
            ok "statusLine → statusline-memory.sh"
        else
            fail "statusLine does NOT point at statusline-memory.sh — thresholds are DEAD"
            fail "  (no heartbeat, no checkpoint/full-save prompts). Current: '${SL:-<unset>}'"
            fails=$((fails + 1))
        fi

        # PostToolUse matcher must include NotebookEdit.
        if jq -e '
            [.hooks.PostToolUse[]?
             | select((.hooks // []) | any(.command // "" | contains("track-changes.sh")))
             | .matcher // ""] | any(contains("NotebookEdit"))
        ' "$SETTINGS_FILE" >/dev/null 2>&1; then
            ok "PostToolUse matcher includes NotebookEdit"
        else
            warn "PostToolUse matcher does not include NotebookEdit (notebook edits untracked)"
        fi
    fi

    # ── Hook scripts ─────────────────────────────────────────────────────────
    echo ""
    printf "${BOLD}Hook scripts:${NC}\n"
    # Reconstruct the version sentinel from two pieces so the installer's global
    # sed (s/__VERSION__/<version>/g over this CLI) does not rewrite this grep
    # pattern — otherwise the installed doctor would grep hooks for the version
    # number and match their own "# mimo v<version>" header.
    local vsentinel="__VER""SION__"
    for hook in statusline-memory.sh memory-gate.sh precompact-save.sh session-start.sh session-start-compact.sh session-end-backup.sh subagent-context.sh user-prompt-context.sh track-changes.sh; do
        dest="$HOOKS_DIR/$hook"
        if [ ! -f "$dest" ]; then
            fail "$hook missing"
            fails=$((fails + 1))
        elif [ ! -x "$dest" ]; then
            fail "$hook not executable"
            fails=$((fails + 1))
        elif grep -qF "$vsentinel" "$dest" 2>/dev/null; then
            fail "$hook contains literal ${vsentinel} (version not stamped)"
            fails=$((fails + 1))
        else
            ok "$hook"
        fi
    done

    # ── Version consistency ──────────────────────────────────────────────────
    echo ""
    printf "${BOLD}Version:${NC}\n"
    INSTALLED_VER=$(cat "$STATE_DIR/mimo-installed-version" 2>/dev/null || echo "")
    if [ -z "$INSTALLED_VER" ]; then
        warn "no mimo-installed-version file (run the installer)"
    elif [ "$INSTALLED_VER" = "$MIMO_VERSION" ]; then
        ok "CLI v${MIMO_VERSION} matches installed-version file"
    else
        fail "CLI v${MIMO_VERSION} != installed-version file (v${INSTALLED_VER}) — stale CLI on PATH?"
        fails=$((fails + 1))
    fi

    # ── Config ───────────────────────────────────────────────────────────────
    echo ""
    printf "${BOLD}Config (${MIMO_CONF}):${NC}\n"
    if [ ! -f "$MIMO_CONF" ]; then
        dim "no mimo.conf (using built-in defaults)"
    else
        # shellcheck disable=SC1090  # config path is user-supplied by design
        if ( set -euo pipefail; . "$MIMO_CONF" ) >/dev/null 2>&1; then
            ok "sources cleanly"
        else
            fail "mimo.conf fails to source (syntax error) — hooks may break"
            fails=$((fails + 1))
        fi
        KNOWN="CHECKPOINT_THRESHOLD FULLSAVE_THRESHOLD BAR_WIDTH AUTO_INIT WORKFLOW_BLOCK BACKUP_RETENTION_DAYS STALE_MINUTES SAVE_AFTER_CHANGES USER_PROFILE"
        CONF_KEYS=$(grep -E '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=' "$MIMO_CONF" 2>/dev/null \
            | sed -E 's/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=.*/\1/' || true)
        UNKNOWN=""
        for key in $CONF_KEYS; do
            found=false
            for k in $KNOWN; do [ "$key" = "$k" ] && found=true && break; done
            [ "$found" = "false" ] && UNKNOWN="$UNKNOWN $key"
        done
        if [ -n "$UNKNOWN" ]; then
            warn "unknown config key(s):$UNKNOWN"
        else
            ok "only known keys"
        fi
    fi

    # ── State + backups ──────────────────────────────────────────────────────
    echo ""
    printf "${BOLD}State + backups:${NC}\n"
    TMP_ORPHANS=0
    STALE=0
    NOW=$(date +%s)
    if [ -d "$STATE_DIR" ]; then
        TMP_ORPHANS=$(find "$STATE_DIR" -name "*.tmp" 2>/dev/null | wc -l | tr -d ' ')
        for f in "$STATE_DIR"/*.json; do
            [ -f "$f" ] || continue
            case "$f" in *.tmp) continue ;; esac
            LU=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)
            [ $(( NOW - LU )) -gt "$STALE_THRESHOLD" ] && STALE=$((STALE + 1))
        done
    fi
    if [ "$TMP_ORPHANS" -gt 0 ]; then
        warn "$TMP_ORPHANS orphan *.tmp file(s) in memory-state (run: mimo cleanup)"
    else
        ok "no orphan temp files"
    fi
    if [ "$STALE" -gt 0 ]; then
        warn "$STALE stale session(s) (run: mimo cleanup)"
    else
        ok "no stale sessions"
    fi
    if [ -d "$BACKUP_DIR" ]; then
        BSIZE=$(du -sh "$BACKUP_DIR" 2>/dev/null | awk '{print $1}')
        BKB=$(du -sk "$BACKUP_DIR" 2>/dev/null | awk '{print $1}')
        case "${BKB:-0}" in ''|*[!0-9]*) BKB=0 ;; esac
        if [ "$BKB" -gt 512000 ]; then
            warn "backups dir is ${BSIZE} (>500MB — consider mimo cleanup)"
        else
            ok "backups dir: ${BSIZE:-0}"
        fi
    else
        dim "no backups dir yet"
    fi

    # ── PATH ─────────────────────────────────────────────────────────────────
    echo ""
    printf "${BOLD}PATH:${NC}\n"
    if echo "$PATH" | tr ':' '\n' | grep -q "^$HOME/.local/bin\$"; then
        ok "\$HOME/.local/bin in PATH"
    else
        warn "\$HOME/.local/bin not in PATH — the mimo CLI may not be found in new shells"
    fi

    # ── Current project (Project Card lint) ──────────────────────────────────
    # Lints the cwd CLAUDE.md's Project Card. All findings are warnings, never
    # fails — a malformed card degrades recall, it does not break the system.
    if [ -f "CLAUDE.md" ] && grep -q '^## Memory — Project Card' CLAUDE.md 2>/dev/null; then
        echo ""
        printf "${BOLD}Project Card (CLAUDE.md):${NC}\n"
        # Duplicate section: the extraction and re-emit both assume exactly one.
        CARD_SECTIONS=$(grep -c '^## Memory — Project Card' CLAUDE.md 2>/dev/null || true)
        case "${CARD_SECTIONS:-0}" in ''|*[!0-9]*) CARD_SECTIONS=0 ;; esac
        [ "$CARD_SECTIONS" -gt 1 ] && warn "Project Card section appears ${CARD_SECTIONS} times (expected one)"
        # Bullets in the card (start heading deleted; next '## ' ends the range).
        CARD_BULLETS=$(sed -n '/^## Memory — Project Card/,/^## /{/^## /d;/^- /p;}' CLAUDE.md 2>/dev/null || true)
        CARD_BAD=0
        CARD_TOTAL=0
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            CARD_TOTAL=$((CARD_TOTAL + 1))
            echo "$line" | grep -qE '^- (STACK|CONVENTION|ENTRYPOINT|TOOL-RULE|FAILURE-LESSON|RELATIONSHIP|INSTRUCTION):' \
                || CARD_BAD=$((CARD_BAD + 1))
        done <<CARD_LINT
$CARD_BULLETS
CARD_LINT
        if [ "$CARD_BAD" -gt 0 ]; then
            warn "${CARD_BAD} Project Card line(s) lack an allowed PREFIX (STACK/CONVENTION/ENTRYPOINT/TOOL-RULE/FAILURE-LESSON/RELATIONSHIP/INSTRUCTION)"
        else
            ok "Project Card prefixes valid (${CARD_TOTAL} lines)"
        fi
        [ "$CARD_TOTAL" -gt 30 ] && warn "Project Card has ${CARD_TOTAL} lines (>30 — trim to durable facts)"
    fi

    # ── User profile lint (P12) ──────────────────────────────────────────────
    # Only when the file exists. All findings are warnings — a malformed profile
    # degrades the injected context, it does not break the system. Every bullet
    # must carry an allowed prefix (a bare imperative like "- always X" fails this
    # check, which is the declarative-only injection defense); warn over 20 lines
    # or 1,600 chars.
    if [ -f "$USER_PROFILE_FILE" ]; then
        echo ""
        printf "${BOLD}User profile (${USER_PROFILE_FILE}):${NC}\n"
        PROF_LINES=$(wc -l < "$USER_PROFILE_FILE" 2>/dev/null | tr -d '[:space:]' || echo 0)
        case "${PROF_LINES:-0}" in ''|*[!0-9]*) PROF_LINES=0 ;; esac
        PROF_CHARS=$(wc -c < "$USER_PROFILE_FILE" 2>/dev/null | tr -d '[:space:]' || echo 0)
        case "${PROF_CHARS:-0}" in ''|*[!0-9]*) PROF_CHARS=0 ;; esac
        PROF_BAD=0
        PROF_TOTAL=0
        while IFS= read -r line; do
            case "$line" in "- "*) ;; *) continue ;; esac
            PROF_TOTAL=$((PROF_TOTAL + 1))
            echo "$line" | grep -qE '^- (PREFERENCE|WORKFLOW|INSTRUCTION|CONTEXT):' \
                || PROF_BAD=$((PROF_BAD + 1))
        done < "$USER_PROFILE_FILE"
        if [ "$PROF_BAD" -gt 0 ]; then
            warn "${PROF_BAD} profile line(s) lack an allowed PREFIX (PREFERENCE/WORKFLOW/INSTRUCTION/CONTEXT)"
        else
            ok "profile prefixes valid (${PROF_TOTAL} entries)"
        fi
        [ "$PROF_LINES" -gt 20 ]   && warn "profile has ${PROF_LINES} lines (>20 — trim to the highest-value facts)"
        [ "$PROF_CHARS" -gt 1600 ] && warn "profile is ${PROF_CHARS} chars (>1600 — trim)"
    fi

    echo ""
    if [ "$fails" -gt 0 ]; then
        error "doctor found $fails problem(s) — see [!!] lines above"
        echo ""
        exit 1
    fi
    info "all checks passed"
    echo ""
}

cmd_help() {
    cat << HELP
mimo v${MIMO_VERSION} — hook-based memory system for Claude Code

Usage: mimo <command>

Commands:
  init [opts]  Initialize memory files in the current project
                 --with-workflow  include the Workflow Orchestration block
                 --force-home     allow init inside \$HOME (normally refused)
  status      Show diagnostic information (hooks, skills, config, sessions)
  doctor      Deep diagnostics (settings registrations, statusLine, config,
              version, orphans, PATH); exits non-zero on any failure
  sessions    List CLAUDE-FULL.md session anchors in the current project
  cleanup     Remove stale session state, orphaned temp files, and old backups
  update      Check for and install the latest version
  version     Print version
  uninstall   Remove mimo from your system
  help        Show this help

Configuration:
  Edit ~/.claude/mimo.conf to change thresholds, auto-init mode, the workflow
  block, backup retention, and stale-session timing. Do NOT edit installed
  hooks — updates overwrite them. See 'mimo status' for active config.

Slash commands (inside Claude Code):
  /save       Save a quick checkpoint (same as auto-checkpoint at 50%)
  /save-full  Full memory save (same as auto-save at 80%)
  /pcompact   Generate context-preserving /compact instructions

Getting started:
  1. mimo is already installed (hooks + settings configured)
  2. Start a Claude Code session — mimo auto-initializes your project
  3. Use 'mimo init' to manually reset memory files if needed

Learn more: https://github.com/ShivanDana/mimo
HELP
}

CMD="${1:-help}"
[ "$#" -gt 0 ] && shift
case "$CMD" in
    init)      cmd_init "$@" ;;
    status)    cmd_status ;;
    doctor)    cmd_doctor ;;
    sessions)  cmd_sessions ;;
    cleanup)   cmd_cleanup ;;
    update)    cmd_update ;;
    version)   cmd_version ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h) cmd_help ;;
    *)
        printf "${RED}[mimo]${NC} Unknown command: %s\n" "$CMD" >&2
        cmd_help
        exit 1
        ;;
esac
