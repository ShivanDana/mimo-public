#!/usr/bin/env bash
# mimo — CLI for the mimo memory system for Claude Code
set -euo pipefail

# Version is stamped by the installer (sed replaces every __VERSION__). When run
# from a dev clone the placeholder is still present, so fall back to the local
# VERSION file, then to "dev". The sentinel is reconstructed from two pieces so
# the installer's global sed does not rewrite this guard as well.
MIMO_VERSION="__VERSION__"
_mimo_placeholder="__VER""SION__"
if [ "$MIMO_VERSION" = "$_mimo_placeholder" ]; then
    MIMO_VERSION=$(cat "$(dirname "$0")/VERSION" 2>/dev/null || echo "dev")
fi
unset _mimo_placeholder
HOOKS_DIR="$HOME/.claude/hooks"
STATE_DIR="$HOME/.claude/memory-state"
BACKUP_DIR="$HOME/.claude/backups"
SETTINGS_FILE="$HOME/.claude/settings.json"
TEMPLATES_DIR="${MIMO_TEMPLATES_DIR:-$HOME/.claude/mimo-templates}"

# ─── Config (defaults, then user overrides via ~/.claude/mimo.conf) ──────────
CHECKPOINT_THRESHOLD=50
FULLSAVE_THRESHOLD=80
BAR_WIDTH=20
AUTO_INIT=git-only
WORKFLOW_BLOCK=off
BACKUP_RETENTION_DAYS=30
STALE_MINUTES=120
MIMO_CONF="${MIMO_CONF:-$HOME/.claude/mimo.conf}"
# shellcheck disable=SC1090
[ -f "$MIMO_CONF" ] && . "$MIMO_CONF"
# Sessions with no StatusLine heartbeat in this many seconds are considered stale
STALE_THRESHOLD=$(( STALE_MINUTES * 60 ))

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

ok()    { printf "  ${GREEN}[ok]${NC} %s\n" "$1"; }
fail()  { printf "  ${RED}[!!]${NC} %s\n" "$1"; }
dim()   { printf "  ${YELLOW}[-]${NC}  %s\n" "$1"; }
info()  { printf "${GREEN}[mimo]${NC} %s\n" "$1"; }
error() { printf "${RED}[mimo]${NC} %s\n" "$1" >&2; }

cmd_version() {
    echo "mimo v${MIMO_VERSION}"
}

cmd_status() {
    echo ""
    printf "${BOLD}mimo status${NC}\n"
    echo ""

    # Hook scripts
    printf "${BOLD}Hook scripts:${NC}\n"
    for hook in statusline-memory.sh memory-gate.sh precompact-save.sh session-start.sh session-start-compact.sh session-end-backup.sh subagent-context.sh user-prompt-context.sh track-changes.sh; do
        if [ -x "$HOOKS_DIR/$hook" ]; then
            ok "$hook"
        else
            fail "$hook (missing or not executable)"
        fi
    done

    echo ""
    printf "${BOLD}Settings:${NC}\n"
    if [ -f "$SETTINGS_FILE" ]; then
        HOOK_COUNT=$(jq '[.hooks[][]?.hooks[]? | select(.command // "" | contains("/.claude/hooks/"))] | length' "$SETTINGS_FILE" 2>/dev/null || echo "0")
        if [ "$HOOK_COUNT" -gt 0 ]; then
            ok "Hooks registered in settings.json ($HOOK_COUNT entries)"
        else
            fail "No mimo hooks found in settings.json"
        fi

        SL=$(jq -r '.statusLine.command // ""' "$SETTINGS_FILE" 2>/dev/null || echo "")
        if echo "$SL" | grep -q 'statusline-memory'; then
            ok "StatusLine configured"
        else
            fail "StatusLine not configured"
        fi
    else
        fail "settings.json not found"
    fi

    echo ""
    printf "${BOLD}Dependencies:${NC}\n"
    if command -v jq &>/dev/null; then
        ok "jq $(jq --version 2>&1 | tr -d 'jq-')"
    else
        fail "jq not installed"
    fi
    ok "bash ${BASH_VERSION}"

    echo ""
    printf "${BOLD}Skills:${NC}\n"
    for skill in save save-full pcompact; do
        if [ -f "$HOME/.claude/skills/$skill/SKILL.md" ]; then
            ok "/$skill"
        else
            fail "/$skill (not installed)"
        fi
    done

    echo ""
    printf "${BOLD}Config:${NC}\n"
    if [ -f "$MIMO_CONF" ]; then
        OVERRIDES=""
        [ "$CHECKPOINT_THRESHOLD" != "50" ]  && OVERRIDES="$OVERRIDES CHECKPOINT_THRESHOLD=$CHECKPOINT_THRESHOLD"
        [ "$FULLSAVE_THRESHOLD" != "80" ]    && OVERRIDES="$OVERRIDES FULLSAVE_THRESHOLD=$FULLSAVE_THRESHOLD"
        [ "$BAR_WIDTH" != "20" ]             && OVERRIDES="$OVERRIDES BAR_WIDTH=$BAR_WIDTH"
        [ "$AUTO_INIT" != "git-only" ]       && OVERRIDES="$OVERRIDES AUTO_INIT=$AUTO_INIT"
        [ "$WORKFLOW_BLOCK" != "off" ]       && OVERRIDES="$OVERRIDES WORKFLOW_BLOCK=$WORKFLOW_BLOCK"
        [ "$BACKUP_RETENTION_DAYS" != "30" ] && OVERRIDES="$OVERRIDES BACKUP_RETENTION_DAYS=$BACKUP_RETENTION_DAYS"
        [ "$STALE_MINUTES" != "120" ]        && OVERRIDES="$OVERRIDES STALE_MINUTES=$STALE_MINUTES"
        if [ -n "$OVERRIDES" ]; then
            ok "$MIMO_CONF (overrides:)"
            for kv in $OVERRIDES; do dim "$kv"; done
        else
            ok "$MIMO_CONF (all defaults)"
        fi
    else
        dim "defaults (no ~/.claude/mimo.conf)"
    fi

    echo ""
    printf "${BOLD}Active sessions:${NC}\n"
    SESSION_COUNT=0
    NOW=$(date +%s)
    if [ -d "$STATE_DIR" ]; then
        for sf in "$STATE_DIR"/*.json; do
            [ -f "$sf" ] || continue
            case "$sf" in *.tmp) continue ;; esac
            SESSION_COUNT=$((SESSION_COUNT + 1))
            SID=$(jq -r '.session_id // "?"' "$sf" 2>/dev/null || echo "?")
            PCT=$(jq -r '.percentage // 0' "$sf" 2>/dev/null || echo "0")
            THRESHOLD=$(jq -r '.threshold // "clean"' "$sf" 2>/dev/null || echo "clean")
            LAST_UPDATE=$(stat -f %m "$sf" 2>/dev/null || stat -c %Y "$sf" 2>/dev/null || echo "0")
            AGE=$(( NOW - LAST_UPDATE ))
            if [ "$AGE" -gt "$STALE_THRESHOLD" ]; then
                dim "${SID}: ${PCT}%, stale (last seen $(( AGE / 3600 ))h ago)"
            else
                ok "${SID}: ${PCT}%, threshold: ${THRESHOLD}"
            fi
        done
    fi
    if [ "$SESSION_COUNT" -eq 0 ]; then
        dim "No active sessions"
    fi

    echo ""
    printf "${BOLD}Current project:${NC}\n"
    if [ -f "CLAUDE.md" ]; then
        if grep -q 'Memory — Current State' CLAUDE.md 2>/dev/null; then
            ok "CLAUDE.md has memory sections"
        else
            dim "CLAUDE.md exists but no memory sections (run: mimo init)"
        fi
    else
        dim "No CLAUDE.md in current directory"
    fi
    if [ -f "CLAUDE-FULL.md" ]; then
        LINES=$(wc -l < "CLAUDE-FULL.md" | tr -d ' ')
        ok "CLAUDE-FULL.md (${LINES} lines)"
    else
        dim "No CLAUDE-FULL.md (run: mimo init)"
    fi

    echo ""
}

# Emit the memory sections — from the installed template, with a built-in
# fallback so `mimo init` still works if templates are missing.
_emit_memory_sections() {
    if [ -f "$TEMPLATES_DIR/claude-md-memory-sections.md" ]; then
        cat "$TEMPLATES_DIR/claude-md-memory-sections.md"
    else
        cat << 'MEMORY_SECTIONS'
## Memory — Current State
<!-- Updated by mimo checkpoint/save hooks -->
Last session: (not yet set)
Current focus: (not yet set)
Blockers: None

## Memory — Recent Sessions
<!-- Rolling list, max 7 entries. Oldest dropped. -->

## Memory — Key Decisions
<!-- One-liner + CLAUDE-FULL.md line ref for reasoning -->
MEMORY_SECTIONS
    fi
}

cmd_init() {
    local with_workflow=false force_home=false
    for arg in "$@"; do
        case "$arg" in
            --with-workflow) with_workflow=true ;;
            --force-home)    force_home=true ;;
            *) error "Unknown option for init: $arg"; exit 1 ;;
        esac
    done
    # WORKFLOW_BLOCK=on in the config also opts every init into the workflow block.
    [ "$WORKFLOW_BLOCK" = "on" ] && with_workflow=true

    # $HOME guard: a CLAUDE.md here loads into every Claude Code session
    # (cross-project contamination). Require an explicit override.
    if [ "$(pwd)" = "$HOME" ] && [ "$force_home" != "true" ]; then
        error "Refusing to initialize memory in your home directory ($HOME)."
        error "A CLAUDE.md here loads into EVERY Claude Code session (cross-project contamination)."
        error "Re-run with 'mimo init --force-home' if you really mean to."
        exit 1
    fi

    echo ""
    printf "${BOLD}mimo init${NC} — setting up memory for this project\n"
    echo ""

    MEMORY_MARKER="Memory — Current State"

    # CLAUDE.md
    if [ ! -f "CLAUDE.md" ]; then
        # Fresh file: title + description, optional workflow block, memory sections.
        {
            echo "# CLAUDE.md"
            echo ""
            echo "This file provides guidance to Claude Code (claude.ai/code) when working with code in this repository."
            echo ""
            if [ "$with_workflow" = "true" ]; then
                if [ -f "$TEMPLATES_DIR/claude-md-workflow.md" ]; then
                    cat "$TEMPLATES_DIR/claude-md-workflow.md"
                    echo ""
                else
                    warn "workflow template missing ($TEMPLATES_DIR) — skipping workflow block"
                fi
            fi
            _emit_memory_sections
        } > CLAUDE.md
        if [ "$with_workflow" = "true" ]; then
            ok "Created CLAUDE.md with workflow guidance and memory sections"
        else
            ok "Created CLAUDE.md with memory sections"
        fi

    elif grep -q "$MEMORY_MARKER" CLAUDE.md 2>/dev/null; then
        ok "CLAUDE.md already has memory sections (skipping)"

    else
        # Existing CLAUDE.md without memory sections. Never prepend: appending
        # keeps the file's opening bytes intact (no duplicate # CLAUDE.md title,
        # no disruption of the user's own top content). With --with-workflow and
        # no existing block, append the workflow block at the END too.
        if [ "$with_workflow" = "true" ] \
           && ! grep -q "## Workflow Orchestration" CLAUDE.md 2>/dev/null; then
            if [ -f "$TEMPLATES_DIR/claude-md-workflow.md" ]; then
                {
                    echo ""
                    cat "$TEMPLATES_DIR/claude-md-workflow.md"
                } >> CLAUDE.md
                ok "Appended workflow guidance to CLAUDE.md"
            else
                warn "workflow template missing ($TEMPLATES_DIR) — skipping workflow block"
            fi
        fi
        {
            echo ""
            _emit_memory_sections
        } >> CLAUDE.md
        ok "Added memory sections to CLAUDE.md"
    fi

    # CLAUDE-FULL.md
    if [ -f "CLAUDE-FULL.md" ]; then
        ok "CLAUDE-FULL.md already exists (skipping)"
    else
        if [ -f "$TEMPLATES_DIR/CLAUDE-FULL.md" ]; then
            cat "$TEMPLATES_DIR/CLAUDE-FULL.md" > CLAUDE-FULL.md
        else
            cat > CLAUDE-FULL.md << 'ARCHIVE'
# Deep Memory Archive

<!-- Detailed session logs for long-term context preservation. -->

## Sessions
ARCHIVE
        fi
        ok "Created CLAUDE-FULL.md"
    fi

    echo ""
    printf "${GREEN}[mimo]${NC} Project initialized. Start a Claude Code session to begin building memory.\n"
    echo ""
}

cmd_update() {
    echo ""
    printf "${BOLD}mimo update${NC}\n"
    echo ""

    REMOTE_VERSION=$(curl -fsSL --max-time 5 \
        "https://raw.githubusercontent.com/ShivanDana/mimo/main/VERSION" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$REMOTE_VERSION" ]; then
        error "Could not fetch remote version. Check your network connection."
        exit 1
    fi

    INSTALLED_VERSION=$(cat "$STATE_DIR/mimo-installed-version" 2>/dev/null || echo "unknown")

    if [ "$REMOTE_VERSION" = "$INSTALLED_VERSION" ]; then
        info "Already up to date (v${INSTALLED_VERSION})"
        exit 0
    fi

    info "Updating mimo v${INSTALLED_VERSION} → v${REMOTE_VERSION}..."
    echo ""

    # Run the installer pinned to the target version. Fall back to main if the
    # version tag does not exist yet (tags may lag the VERSION file).
    PINNED_URL="https://raw.githubusercontent.com/ShivanDana/mimo/v${REMOTE_VERSION}/install.sh"
    MAIN_URL="https://raw.githubusercontent.com/ShivanDana/mimo/main/install.sh"

    INSTALLER=$(curl -fsSL "$PINNED_URL" 2>/dev/null || echo "")
    if [ -z "$INSTALLER" ]; then
        INSTALLER=$(curl -fsSL "$MAIN_URL" 2>/dev/null || echo "")
    fi
    if [ -z "$INSTALLER" ]; then
        error "Could not download the installer. Check your network connection."
        exit 1
    fi
    echo "$INSTALLER" | bash
}

cmd_uninstall() {
    if [ -f "$HOME/.local/bin/mimo-uninstall" ]; then
        exec bash "$HOME/.local/bin/mimo-uninstall"
    else
        printf "${RED}[mimo]${NC} mimo-uninstall not found. Run manually:\n" >&2
        echo "  curl -fsSL https://raw.githubusercontent.com/ShivanDana/mimo/main/uninstall.sh | bash"
        exit 1
    fi
}

cmd_cleanup() {
    echo ""
    printf "${BOLD}mimo cleanup${NC}\n"
    echo ""

    NOW=$(date +%s)
    STALE_COUNT=0
    ORPHAN_COUNT=0
    TMP_COUNT=0
    BACKUP_COUNT=0

    if [ -d "$STATE_DIR" ]; then
        # Remove stale session triples (no StatusLine heartbeat in >2h)
        for f in "$STATE_DIR"/*.json; do
            [ -f "$f" ] || continue
            case "$f" in *.tmp) continue ;; esac
            LAST_UPDATE=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo "0")
            AGE=$(( NOW - LAST_UPDATE ))
            if [ "$AGE" -gt "$STALE_THRESHOLD" ]; then
                SID=$(basename "$f" .json)
                rm -f "$f" "$STATE_DIR/${SID}-changes.log" "$STATE_DIR/${SID}-postcompact.flag"
                STALE_COUNT=$((STALE_COUNT + 1))
            fi
        done

        # Sweep orphaned companion files: -changes.log / -postcompact.flag whose
        # json is already gone (e.g. reaped earlier by session-start cleanup). The
        # loop above only reaches companions of a still-present stale json, so a
        # json-less companion would otherwise linger forever. Deleted pairwise —
        # only when no matching json exists, so live sessions are never touched.
        for f in "$STATE_DIR"/*-changes.log "$STATE_DIR"/*-postcompact.flag; do
            [ -f "$f" ] || continue
            BASE=$(basename "$f")
            case "$BASE" in
                *-changes.log)      SID=${BASE%-changes.log} ;;
                *-postcompact.flag) SID=${BASE%-postcompact.flag} ;;
                *)                  continue ;;
            esac
            if [ ! -f "$STATE_DIR/${SID}.json" ]; then
                rm -f "$f"
                ORPHAN_COUNT=$((ORPHAN_COUNT + 1))
            fi
        done

        # Remove orphaned jq temp files older than 60 min
        TMP_COUNT=$(find "$STATE_DIR" -name "*.tmp" -mmin +60 2>/dev/null | wc -l | tr -d ' ')
        find "$STATE_DIR" -name "*.tmp" -mmin +60 -delete 2>/dev/null || true
    fi

    # Prune transcript backups older than the retention window
    if [ -d "$BACKUP_DIR" ]; then
        BACKUP_COUNT=$(find "$BACKUP_DIR" \( -name "*.jsonl" -o -name "*-precompact-summary.md" \) -mtime +${BACKUP_RETENTION_DAYS} 2>/dev/null | wc -l | tr -d ' ')
        find "$BACKUP_DIR" \( -name "*.jsonl" -o -name "*-precompact-summary.md" \) -mtime +${BACKUP_RETENTION_DAYS} -delete 2>/dev/null || true
    fi

    if [ "$STALE_COUNT" -gt 0 ]; then
        info "Removed $STALE_COUNT stale session(s)"
    else
        info "No stale sessions found (all sessions are active)"
    fi
    if [ "$ORPHAN_COUNT" -gt 0 ]; then
        info "Removed $ORPHAN_COUNT orphaned companion file(s)"
    fi
    info "Removed $TMP_COUNT orphaned temp file(s)"
    info "Removed $BACKUP_COUNT old backup(s) (>${BACKUP_RETENTION_DAYS}d)"
    echo ""
}

cmd_help() {
    cat << HELP
mimo v${MIMO_VERSION} — hook-based memory system for Claude Code

Usage: mimo <command>

Commands:
  init [opts]  Initialize memory files in the current project
                 --with-workflow  include the Workflow Orchestration block
                 --force-home     allow init inside \$HOME (normally refused)
  status      Show diagnostic information (hooks, skills, config, sessions)
  cleanup     Remove stale session state, orphaned temp files, and old backups
  update      Check for and install the latest version
  version     Print version
  uninstall   Remove mimo from your system
  help        Show this help

Configuration:
  Edit ~/.claude/mimo.conf to change thresholds, auto-init mode, the workflow
  block, backup retention, and stale-session timing. Do NOT edit installed
  hooks — updates overwrite them. See 'mimo status' for active config.

Slash commands (inside Claude Code):
  /save       Save a quick checkpoint (same as auto-checkpoint at 50%)
  /save-full  Full memory save (same as auto-save at 80%)
  /pcompact   Generate context-preserving /compact instructions

Getting started:
  1. mimo is already installed (hooks + settings configured)
  2. Start a Claude Code session — mimo auto-initializes your project
  3. Use 'mimo init' to manually reset memory files if needed

Learn more: https://github.com/ShivanDana/mimo
HELP
}

CMD="${1:-help}"
[ "$#" -gt 0 ] && shift
case "$CMD" in
    init)      cmd_init "$@" ;;
    status)    cmd_status ;;
    cleanup)   cmd_cleanup ;;
    update)    cmd_update ;;
    version)   cmd_version ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h) cmd_help ;;
    *)
        printf "${RED}[mimo]${NC} Unknown command: %s\n" "$CMD" >&2
        cmd_help
        exit 1
        ;;
esac
